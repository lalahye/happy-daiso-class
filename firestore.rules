rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() { return signedIn() && request.auth.uid == 'pyE3U5Ra0SRuK6WLzHQFflPyUZB3'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.points == 0;
      allow update: if isTeacher() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role);
      allow delete: if isTeacher();
    }

    match /worksheets/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /classSettings/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /praises/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /voices/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /artworks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /selfCompliments/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /voteSuggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /votes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /couponSuggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /couponPurchases/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    match /pointTransactions/{id} {
      allow create: if isTeacher() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    // 이전 버전의 포인트 조정 대기열. 새 요청은 만들지 않습니다.
    match /teacherPointAdjustments/{id} {
      allow read, delete: if isTeacher();
      allow create, update: if false;
    }

    match /classPointContributions/{id} {
      // 교사는 학급 포인트 추가/차감/적립 취소 내역을 모두 생성할 수 있습니다.
      // 학생은 자기 포인트를 우리 반에 적립하는 양수 내역만 생성할 수 있습니다.
      allow create: if isTeacher() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000
      );
      allow read: if signedIn();
      allow update, delete: if isTeacher();
    }

    match /classRewardVotes/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    match /worksheetSubmissions/{id} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    // 보상 문서가 아직 없을 때도 존재 여부 확인(get)이 가능해야 합니다.
    match /worksheetRewards/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }


    // 퀴즈는 학생별·날짜별 문서를 딱 한 번만 생성합니다.
    // 학생은 자기 응시 기록을 읽고 최초 1회 생성만 가능하며 수정/삭제는 할 수 없습니다.
    match /quizAttempts/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    // 같은 학생 + 같은 날짜 문서는 한 번만 생성되므로 퀴즈 보상은 하루 1회만 지급됩니다.
    match /quizDailyRewards/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /missionCompletions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    // 학습방 보상 장부 V2: 같은 학생+같은 문제지는 한 번만 생성됩니다.
    match /worksheetRewardClaims/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }
  }
}
