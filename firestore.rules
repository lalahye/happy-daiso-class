rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUserDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isTeacher() { return signedIn() && myUserDoc().data.role == 'teacher'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.points == 0;
      allow update: if isTeacher() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role);
      allow delete: if isTeacher();
    }

    match /worksheets/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /classSettings/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /praises/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /voices/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /artworks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /selfCompliments/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /voteSuggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /votes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /couponSuggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isTeacher();
    }

    match /couponPurchases/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    match /pointTransactions/{id} {
      allow create: if isTeacher() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    // 교사는 학생 users 문서를 직접 수정하지 않고 조정 요청을 남깁니다.
    // 학생 앱이 자신의 users 문서에 조정값을 반영하므로 교사→학생 문서 쓰기 403을 피합니다.
    match /teacherPointAdjustments/{id} {
      allow create: if signedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.amount is int
        && request.resource.data.amount != 0
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
          || resource.data.teacherUid == request.auth.uid
          || isTeacher());

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','balanceAfter','appliedAt']);

      allow delete: if isTeacher();
    }

    match /classPointContributions/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && (
          (request.resource.data.amount > 0 && request.resource.data.amount <= 1000)
          || request.resource.data.type == 'teacherAddition'
          || request.resource.data.type == 'teacherDeduction'
        );
      allow read: if signedIn();
      allow update, delete: if isTeacher();
    }

    match /classRewardVotes/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    match /worksheetSubmissions/{id} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    // 보상 문서가 아직 없을 때도 존재 여부 확인(get)이 가능해야 합니다.
    match /worksheetRewards/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    // 같은 학생 + 같은 날짜 문서는 한 번만 생성되므로 퀴즈 보상은 하루 1회만 지급됩니다.
    match /quizDailyRewards/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /missionCompletions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }
  }
}
